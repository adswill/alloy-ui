{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Alloy view",
  "scopeName": "source.alloy",
  "fileTypes": ["alloy"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#theme-line" },
    { "include": "#element" },
    { "include": "#unknown-element" },
    { "include": "#string" },
    { "include": "#attribute" },
    { "include": "#action" },
    { "include": "#flag" },
    { "include": "#color" },
    { "include": "#number" },
    { "include": "#keyword-value" }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*(#).*$",
      "name": "comment.line.number-sign.alloy",
      "captures": { "1": { "name": "punctuation.definition.comment.alloy" } }
    },
    "theme-line": {
      "match": "^\\s*(theme)\\b",
      "captures": { "1": { "name": "keyword.control.theme.alloy" } }
    },
    "element": {
      "match": "^\\s*(col|row|text|heading|caption|button|rule|space|vspace|gap)\\b",
      "captures": { "1": { "name": "entity.name.tag.alloy" } }
    },
    "unknown-element": {
      "match": "^\\s*([A-Za-z_][\\w-]*)\\b(?=\\s|$)",
      "captures": { "1": { "name": "invalid.illegal.unknown-element.alloy" } }
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.alloy",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.alloy" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.alloy" } },
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.alloy" },
        {
          "match": "(\\{)([A-Za-z_][\\w.-]*)(\\})",
          "name": "meta.interpolation.alloy",
          "captures": {
            "1": { "name": "punctuation.section.interpolation.begin.alloy" },
            "2": { "name": "variable.other.interpolated.alloy" },
            "3": { "name": "punctuation.section.interpolation.end.alloy" }
          }
        }
      ]
    },
    "attribute": {
      "match": "\\b(gap|pad|w|h|accent|density|contrast)(=)",
      "captures": {
        "1": { "name": "entity.other.attribute-name.alloy" },
        "2": { "name": "keyword.operator.assignment.alloy" }
      }
    },
    "action": {
      "match": "(@)([A-Za-z_][\\w-]*)",
      "captures": {
        "1": { "name": "punctuation.definition.action.alloy" },
        "2": { "name": "entity.name.function.action.alloy" }
      }
    },
    "flag": {
      "match": "(?<![\\w=#])(page|fill|center|dim|danger|success|accent|primary|ghost|dark|light)(?![\\w=])",
      "name": "support.constant.flag.alloy"
    },
    "color": {
      "match": "#[0-9A-Fa-f]{6}\\b",
      "name": "constant.other.color.alloy"
    },
    "number": {
      "match": "(?<==)-?\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.alloy"
    },
    "keyword-value": {
      "match": "(?<==)(compact|spacious|high)\\b",
      "name": "constant.language.alloy"
    }
  }
}
